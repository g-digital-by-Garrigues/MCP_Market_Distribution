# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
*.tsbuildinfo

# Test output
coverage/
.nyc_output/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment files (consumer credentials)
.env
.env.local
.env.*.local

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# Generated artifacts inside per-MCP source folders
# (Prep Agent commits server.json, smithery.yaml, README.md, install-blocks/
# back into pending-to-publish/<mcp>/, but build outputs from the MCP itself
# are gitignored)
pending-to-publish/*/dist/
pending-to-publish/*/node_modules/
pending-to-publish/*/coverage/
pending-to-publish/*/.cache/

# Generated n8n node source (Track B output, regenerated each release)
pending-to-publish/*/n8n/dist/
pending-to-publish/*/n8n/node_modules/

# Local cache (e.g., pinned MCP schema fetched once and reused)
.cache/

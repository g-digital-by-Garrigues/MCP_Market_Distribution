{
  "name": "g-digital-mcp-distribution-pipeline",
  "version": "0.0.0-bootstrap",
  "description": "Internal pipeline that publishes g-digital MCP servers and n8n nodes across the MCP ecosystem.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "tsc",
    "test": "vitest --run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"**/*.{ts,json,yaml,yml,md}\"",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.18.0",
    "handlebars": "^4.7.8",
    "js-yaml": "^4.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  }
}

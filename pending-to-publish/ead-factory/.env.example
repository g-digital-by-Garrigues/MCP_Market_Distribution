# Transport: "stdio" for local Claude Code, "http" for remote deployment with auth
TRANSPORT=stdio
HTTP_PORT=3000

# OAuth credentials (Okta client_credentials flow)
# Used both for calling Evidence Manager API and for verifying incoming Bearer tokens (HTTP mode)
OKTA_TOKEN_URL=https://legalappfactory.okta.com/oauth2/aus5zlw4kr0vhHKyx417/v1/token
OKTA_CLIENT_ID=
OKTA_CLIENT_SECRET=
OKTA_SCOPE=token

# Evidence Manager API base URL
API_BASE_URL=https://api.int.gcloudfactory.com/digital-trust

# Signature Manager API base URL
SIGNATURE_API_BASE_URL=https://api.int.gcloudfactory.com/signature-manager

# Optional tenant ID header — only needed for local development
# When connecting to INT/PRE/PRO, the tenant is resolved from the OAuth token
# TENANT_ID=

# Polling configuration for evidence status
POLL_INTERVAL_MS=3000
POLL_MAX_ATTEMPTS=20

# Full flow default file path
FULL_FLOW_FILE_PATH=assets/dama.jpg
# Full flow base email — used to compose participant emails (user+signatory@domain, etc.)
FULL_FLOW_EMAIL_BASE=user@example.com

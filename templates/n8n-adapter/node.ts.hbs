// Auto-generated by the g-digital MCP distribution pipeline.
// Source MCP: {{sourceMcpPackageName}} ({{version}})
// Operations: {{#each operations}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}

import {
  IDataObject,
  IExecuteFunctions,
  INodeExecutionData,
  INodeType,
  INodeTypeDescription,
  NodeOperationError,
} from 'n8n-workflow';

import { Client } from '@modelcontextprotocol/sdk/client/index.js';
import { StdioClientTransport } from '@modelcontextprotocol/sdk/client/stdio.js';
import * as path from 'node:path';

// Absolute path to dist/mcp-server.mjs — the bundled MCP server emitted
// by tsup (ESM, .mjs so Node.js loads it as ES module regardless of the
// package's "type" field). It contains {{sourceMcpPackageName}} + @modelcontextprotocol/sdk
// inlined, so no node_modules lookup is needed at n8n runtime.
// Resolved once at module load; each execute() spawns a fresh process
// with per-call credentials in env (no cross-execution credential bleed).
const MCP_SERVER_PATH = path.join(__dirname, '..', '..', 'mcp-server.mjs');

export class {{className}} implements INodeType {
  description: INodeTypeDescription = {
    displayName: '{{displayName}}',
    name: '{{paramName}}',
    group: ['transform'],
    version: 1,{{#if iconBundled}}
    // Bundled brand icon — copied into nodes/{{className}}/icon.png by
    // the generator (Story 5.X). n8n resolves `file:icon.png` relative
    // to this .node.ts file at runtime, so the catalogue + editor UI
    // render the MCP logo instead of the generic-box placeholder.
    icon: 'file:icon.png',{{/if}}
    // Story 5.8: flag this node as usable by n8n's AI Agent. With this
    // flag, n8n's CLI auto-generates a virtual `<Name>Tool` sibling at
    // startup (clones the description, rewires outputs to `AiTool`, and
    // injects a Tool-Description selector). We do NOT author a second
    // .node.ts file. The LLM sees this top-level `description` string
    // plus each property's `description` to decide which operation to
    // call and how to fill the arguments. Requires n8n-workflow ≥ 1.79.0.
    usableAsTool: true,
    // Surface the node under n8n's AI panel. `categories: ['AI', 'Langchain']`
    // is the convention used by n8n's built-in tool-capable nodes.
    codex: { categories: ['AI', 'Langchain'] },
    description: {{json description}},
    defaults: { name: '{{displayName}}' },
    inputs: ['main'],
    outputs: ['main'],
    credentials: [{ name: '{{credentialParamName}}', required: true }],
    properties: [
      {
        displayName: 'Operation',
        name: 'operation',
        type: 'options',
        noDataExpression: true,
        options: [
{{#each operations}}          {
            name: {{json this.displayName}},
            value: '{{this.name}}',
            description: {{json this.description}},
            action: {{json this.displayName}},
          },
{{/each}}        ],
        default: '{{operations.0.name}}',
      },
{{#each operations}}{{#each this.properties}}      {
        displayName: {{json this.displayName}},
        name: '{{this.name}}',
        type: '{{this.type}}',
        {{#if this.options}}options: [
{{#each this.options}}          { name: {{json this.name}}, value: {{json this.value}}{{#if this.description}}, description: {{json this.description}}{{/if}} },
{{/each}}        ],
        {{/if}}default: {{json this.default}},
        {{#if this.description}}description: {{json this.description}},
        {{/if}}{{#if this.required}}required: true,
        {{/if}}{{#if this.numberConstraints}}typeOptions: {{json this.numberConstraints}},
        {{/if}}displayOptions: { show: { operation: ['{{this.showForOperation}}'] } },
      },
{{/each}}{{/each}}    ],
  };

  async execute(this: IExecuteFunctions): Promise<INodeExecutionData[][]> {
    const items = this.getInputData();
    const out: INodeExecutionData[] = [];
    const credentials = await this.getCredentials('{{credentialParamName}}');

    // Build env for the spawned MCP. We INHERIT process.env first so
    // corp-wide knobs the host has set (NODE_EXTRA_CA_CERTS for TLS
    // inspection, HTTP_PROXY / HTTPS_PROXY / NO_PROXY for outbound
    // proxies, PATH for nested spawns, etc.) reach the child. The
    // credential values then shadow any matching key — n8n credentials
    // are the canonical source of MCP-specific configuration.
    //
    // Without the inherit step the child runs with ONLY the credential
    // fields, so any outbound HTTPS the MCP performs (e.g. to backing
    // APIs in a corp TLS-inspection environment) fails with
    // "self-signed certificate in certificate chain" even when the
    // host n8n process has the corp bundle correctly configured.
    const env: Record<string, string> = {};
    for (const [k, v] of Object.entries(process.env)) {
      if (typeof v === 'string') env[k] = v;
    }
    for (const key of Object.keys(credentials)) {
      const value = credentials[key];
      if (typeof value === 'string') env[key] = value;
    }

    const transport = new StdioClientTransport({
      command: process.execPath,
      args: [MCP_SERVER_PATH],
      env,
    });
    const client = new Client(
      { name: '{{packageName}}', version: '{{version}}' },
      { capabilities: {} },
    );

    try {
      await client.connect(transport);

      for (let i = 0; i < items.length; i++) {
        const operation = this.getNodeParameter('operation', i) as string;
        const args: Record<string, unknown> = {};
        const propsForOp = OPERATION_PROPERTY_NAMES[operation] ?? [];
        for (const propName of propsForOp) {
          // n8n returns the default for absent parameters; downstream
          // tools will reject obviously-empty required values via their
          // own input schema, so we don't second-guess here.
          args[propName] = this.getNodeParameter(propName, i);
        }
        try {
          const response = await client.callTool({ name: operation, arguments: args });
          // n8n's INodeExecutionData.json is typed as IDataObject (a
          // recursive JSON-shaped record). The SDK's callTool returns
          // `{ content: [...] }` — castable as IDataObject for n8n's
          // downstream nodes to read via expressions ($json.content,
          // $json.isError, etc.).
          out.push({ json: response as unknown as IDataObject });
        } catch (err) {
          throw new NodeOperationError(
            this.getNode(),
            `MCP tool '${operation}' failed: ${(err as Error).message}`,
            { itemIndex: i },
          );
        }
      }
    } finally {
      try {
        await client.close();
      } catch {
        /* ignore */
      }
      try {
        await transport.close();
      } catch {
        /* ignore */
      }
    }

    return [out];
  }
}

// Per-operation property names, used by execute() to gather the right
// args dict per tool. Generated from each operation's `properties`.
const OPERATION_PROPERTY_NAMES: Record<string, readonly string[]> = {
{{#each operations}}  '{{this.name}}': [{{#each this.properties}}'{{this.name}}'{{#unless @last}}, {{/unless}}{{/each}}],
{{/each}}
};

          try {
{{#if (eq authStyle 'oauth2-client-credentials')}}
            const docData = await this.helpers.httpRequestWithAuthentication.call(this, '{{credentialParamName}}', { method: 'GET', url: `${url}/document-url`, json: true }) as IDataObject;
            if (docData && docData.documentUrl) (json as IDataObject).documentUrl = docData.documentUrl;
{{else}}
            const docUrlRes = await fetch(`${url}/document-url`, {
              headers: { Authorization: `Bearer ${bearer}` },
            });
            if (docUrlRes.ok) {
              const docData = await docUrlRes.json().catch(() => ({})) as IDataObject;
              if (docData.documentUrl) (json as IDataObject).documentUrl = docData.documentUrl;
            }
{{/if}}
          } catch { /* non-fatal */ }
        }
{{/if}}        // pairedItem links this output back to the input item it came from, so the
        // execution UI can trace a row through the workflow.
        out.push({ json: json as IDataObject, pairedItem: { item: i } });
      } catch (error) {
        if (this.continueOnFail()) {
          out.push({
            json: this.getInputData(i)[0].json,
            error: error as NodeOperationError,
            pairedItem: { item: i },
          });
          continue;
        }
        // Always wrap: a raw re-throw loses the HTTP context in the n8n UI, and n8n's
        // require-node-api-error rule rejects any bare `throw error` inside a catch —
        // even one guarded by an instanceof. NodeApiError carries the message of
        // whatever it is given, so our own NodeApiError/NodeOperationError throws
        // (auth, pre-flight guards, unknown operation) still read the same.
        throw new NodeApiError(this.getNode(), error as JsonObject, { itemIndex: i });
      }
    }

    return [out];
  }
}

// Semantic output field name for auto-generated 'id' values.
// When a _create/_add operation auto-generates a UUID for 'id', it is also
// injected into the output under this field name so downstream nodes can
// reference it with its domain-specific name (e.g. $json.caseFileId).
// Generated per-node from the operations this MCP actually exposes — entries
// for absent operations (e.g. chat_* on a node without chat) are never emitted.
const AUTO_ID_OUTPUT_FIELD: Record<string, string> = {
{{#each autoIdOutputFields}}  '{{this.operation}}': '{{this.fieldName}}',
{{/each}}
};

// HTTP metadata per operation — method + URL template.
// 'stub: true' means the tool has no REST annotation and requires self-hosted n8n.
const OPERATION_META: Record<string, { method: string; urlTemplate: string; stub?: true }> = {
{{#each operations}}  '{{this.name}}': { method: '{{this.httpMethod}}', urlTemplate: {{json this.httpUrlTemplate}}{{safe this.stubSuffix}} },
{{/each}}
};

// Per-operation input property names for argument gathering.
const OPERATION_PROPERTY_NAMES: Record<string, readonly string[]> = {
{{#each operations}}  '{{this.name}}': [{{#each this.properties}}'{{this.name}}'{{#unless @last}}, {{/unless}}{{/each}}],
{{/each}} };

// Per-operation default values for OPTIONAL body parameters (Story 13.1 / FR51).
// A value equal to its default is treated as "unset" and omitted from the request.
// Required params and path params are never listed here, so a genuinely missing
// required field still surfaces as an API error.
const OPTIONAL_DEFAULTS: Record<string, Record<string, unknown>> = {
{{#each optionalDefaults}}  '{{this.operation}}': { {{#each this.defaults}}'{{this.prop}}': {{safe this.valueJson}},{{#unless @last}} {{/unless}}{{/each}} },
{{/each}} };

// Per-operation manager base-path prefix (Story 13.3 / FR53). Non-empty only for
// multi-manager products; inserted between the credential base URL and the op path
// so a single credential (gateway root) serves every manager.
const OPERATION_BASE_PREFIX: Record<string, string> = {
{{#each operationBasePrefix}}  '{{this.operation}}': '{{this.prefix}}',
{{/each}} };

// Per-operation pre-flight guards (Story 13.2a tier 3 / FR52). Each entry says "this
// field is mandatory when the server reports <driver> is X" — a condition set on a
// DIFFERENT operation, which n8n's displayOptions cannot see. execute() resolves it from
// the server ONLY when the field was left empty, and never blocks on a failed lookup.
interface PreflightGuard {
  field: string;
  lookupUrl: string;
  arrayPath?: string;
  matchParam?: string;
  driver: string;
  equals?: string;
  matchesRe?: string;
  message: string;
}
const PREFLIGHT_GUARDS: Record<string, readonly PreflightGuard[]> = {
{{#each preflightGuards}}  '{{this.operation}}': {{json this.guards}},
{{/each}} };

// GET query-parameter serialization style (Story 13.3/13.6). 'flat' spreads a
// top-level object (e.g. filter) into key=val params; 'bracket' uses qs-style
// filter[key]=val. Empty template value → default 'bracket'.
const QUERY_PARAM_STYLE: 'bracket' | 'flat' = ('{{queryParamStyle}}' as string) === 'flat' ? 'flat' : 'bracket';

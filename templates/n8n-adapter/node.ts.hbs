// Auto-generated by the g-digital MCP distribution pipeline.
// Source MCP: {{sourceMcpPackageName}} ({{version}})
// Architecture: REST-direct (Epic 12 ADR 0008) — pure fetch(), no MCP subprocess.
// Operations: {{#each operations}}{{this.name}}{{#unless @last}}, {{/unless}}{{/each}}

import { randomUUID } from 'node:crypto';
import {
  IDataObject,
  IExecuteFunctions,
  INodeExecutionData,
  INodeType,
  INodeTypeDescription,
  NodeOperationError,
} from 'n8n-workflow';

export class {{className}} implements INodeType {
  description: INodeTypeDescription = {
    displayName: '{{displayName}}',
    name: '{{paramName}}',
    group: ['transform'],
    version: 1,{{#if iconBundled}}
    icon: 'file:icon.png',{{/if}}
    usableAsTool: true,
    codex: { categories: ['AI', 'Langchain'] },
    description: {{json description}},
    defaults: { name: '{{displayName}}' },
    inputs: ['main'],
    outputs: ['main'],
    credentials: [{ name: '{{credentialParamName}}', required: true }],
    properties: [
      {
        displayName: 'Operation',
        name: 'operation',
        type: 'options',
        options: [
{{#each operations}}          {
            name: {{json this.displayName}},
            value: '{{this.name}}',
            description: {{json this.description}},
            action: {{json this.displayName}},
          },
{{/each}}        ],
        default: '{{operations.0.name}}',
      },
{{#each operations}}{{#each this.properties}}      {
        displayName: {{json this.displayName}},
        name: '{{this.name}}',
        type: '{{this.type}}',
        {{#if this.options}}options: [
{{#each this.options}}          { name: {{json this.name}}, value: {{json this.value}}{{#if this.description}}, description: {{json this.description}}{{/if}} },
{{/each}}        ],
        {{/if}}default: {{json this.default}},
        {{#if this.description}}description: {{json this.description}},
        {{/if}}{{#if this.required}}required: true,
        {{/if}}{{#if this.numberConstraints}}typeOptions: {{json this.numberConstraints}},
        {{/if}}displayOptions: { show: { operation: ['{{this.showForOperation}}'] } },
      },
{{/each}}{{/each}}    ],
  };

  async execute(this: IExecuteFunctions): Promise<INodeExecutionData[][]> {
    const items = this.getInputData();
    const out: INodeExecutionData[] = [];
    const creds = await this.getCredentials('{{credentialParamName}}');
    const baseUrl = String(creds.baseUrl ?? '').replace(/\/$/, '');

    // --- Obtain Bearer token (once per execute call) ---
{{#if (eq authStyle 'okta-client-credentials')}}
    const tokenParams = new URLSearchParams({
      grant_type: 'client_credentials',
      client_id: String(creds.OKTA_CLIENT_ID ?? ''),
      client_secret: String(creds.OKTA_CLIENT_SECRET ?? ''),
      scope: String(creds.OKTA_SCOPE ?? 'token'),
    });
    const tokenRes = await fetch(String(creds.OKTA_TOKEN_URL ?? ''), {
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: tokenParams.toString(),
    });
    if (!tokenRes.ok) {
      throw new NodeOperationError(this.getNode(), `Auth failed: HTTP ${tokenRes.status}. Check OKTA_TOKEN_URL, OKTA_CLIENT_ID, and OKTA_CLIENT_SECRET.`);
    }
    const tokenBody = await tokenRes.json() as { access_token?: string };
    const bearer = tokenBody.access_token ?? '';
{{else}}
    const loginRes = await fetch(`${baseUrl}/session`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        email: creds.MCP_AUTH_EMAIL ?? creds.email ?? '',
        password: creds.MCP_AUTH_PASSWORD ?? creds.password ?? '',
      }),
    });
    if (!loginRes.ok) {
      throw new NodeOperationError(this.getNode(), `Auth failed: HTTP ${loginRes.status}. Check MCP_AUTH_EMAIL and MCP_AUTH_PASSWORD.`);
    }
    const loginBody = await loginRes.json() as { jwt?: string; token?: string; accessToken?: string };
    const bearer = loginBody.jwt ?? loginBody.token ?? loginBody.accessToken ?? '';
{{/if}}

    // --- Per-item REST calls ---
    for (let i = 0; i < items.length; i++) {
      try {
        const operation = this.getNodeParameter('operation', i) as string;
        const meta = OPERATION_META[operation];
        if (!meta) {
          throw new NodeOperationError(this.getNode(), `Unknown operation: ${operation}`, { itemIndex: i });
        }
        if (meta.stub) {
          throw new NodeOperationError(
            this.getNode(),
            `Operation '${operation}' requires n8n self-hosted with the @g-digital/mcp-* package. It is not available in n8n Cloud via this connector.`,
            { itemIndex: i },
          );
        }

        // Replace URL path params {paramName} from input; remaining args → body/query
        let url = `${baseUrl}${meta.urlTemplate}`;
        const propsForOp = OPERATION_PROPERTY_NAMES[operation] ?? [];
        const body: Record<string, unknown> = {};
        for (const propName of propsForOp) {
          const val = this.getNodeParameter(propName, i);
          if (val === '' || val === null || val === undefined) continue;
          if (typeof val === 'object' && !Array.isArray(val) && Object.keys(val as object).length === 0) continue;
          const placeholder = `{${propName}}`;
          if (url.includes(placeholder)) {
            url = url.replace(placeholder, encodeURIComponent(String(val)));
          } else {
            body[propName] = val;
          }
        }
        // Substitute any remaining {placeholder} patterns from credentials.
        // First try exact credential key names, then common API→credential aliases
        // (e.g. {email} in session_info maps to credential field MCP_AUTH_EMAIL).
        const credAliases: Record<string, string> = { email: 'MCP_AUTH_EMAIL' };
        for (const [credKey, credVal] of Object.entries(creds)) {
          const placeholder = `{${credKey}}`;
          if (url.includes(placeholder) && credVal) {
            url = url.replace(placeholder, encodeURIComponent(String(credVal)));
          }
        }
        for (const [alias, credKey] of Object.entries(credAliases)) {
          const placeholder = `{${alias}}`;
          if (url.includes(placeholder) && creds[credKey]) {
            url = url.replace(placeholder, encodeURIComponent(String(creds[credKey])));
          }
        }

        // --- Smart defaults for common fields ---
        // Auto-generate UUID v4 for 'id' field in create operations
        if ('id' in body && (body.id === '' || body.id === null || body.id === undefined)) {
          body.id = randomUUID();
        }
        // validityFrom: default to now (ISO 8601)
        if ('validityFrom' in body && (body.validityFrom === '' || body.validityFrom === null || body.validityFrom === undefined)) {
          body.validityFrom = new Date().toISOString();
        }
        // validityTo: default to 1 year from now
        if ('validityTo' in body && (body.validityTo === '' || body.validityTo === null || body.validityTo === undefined)) {
          const oneYearLater = new Date();
          oneYearLater.setFullYear(oneYearLater.getFullYear() + 1);
          body.validityTo = oneYearLater.toISOString();
        }

        const isBodyless = meta.method === 'GET' || meta.method === 'DELETE';
        if (isBodyless && Object.keys(body).length > 0) {
          // GoCertius uses OpenAPI form+explode serialization for object query params:
          // object properties are flattened directly into the query string WITHOUT
          // the parent parameter name as prefix.
          // e.g. { page: { number: 1, size: 20 }, filter: { ownerId: 'uuid' } }
          //   → number=1&size=20&ownerId=uuid  (NOT page[number]=1)
          const flattenQs = (obj: IDataObject): Array<[string, string]> => {
            const pairs: Array<[string, string]> = [];
            for (const [k, v] of Object.entries(obj)) {
              if (v === null || v === undefined || v === '') continue;
              if (typeof v === 'object' && !Array.isArray(v)) {
                if (Object.keys(v as object).length === 0) continue;
                // Form+explode: merge properties without the parent key prefix
                for (const [pk, pv] of Object.entries(v as IDataObject)) {
                  if (pv !== null && pv !== undefined && pv !== '') {
                    pairs.push([pk, String(pv)]);
                  }
                }
              } else if (Array.isArray(v)) {
                for (const item of v) pairs.push([`${k}[]`, String(item)]);
              } else {
                pairs.push([k, String(v)]);
              }
            }
            return pairs;
          };
          const pairs = flattenQs(body);
          if (pairs.length > 0) {
            url = `${url}?${new URLSearchParams(pairs).toString()}`;
          }
        }

        const apiRes = await fetch(url, {
          method: meta.method,
          headers: {
            Authorization: `Bearer ${bearer}`,
            ...(isBodyless ? {} : { 'Content-Type': 'application/json' }),
          },
          ...(isBodyless ? {} : { body: JSON.stringify(body) }),
        });

        if (!apiRes.ok) {
          const errText = await apiRes.text().catch(() => '');
          throw new NodeOperationError(
            this.getNode(),
            `${operation} failed: HTTP ${apiRes.status}${errText ? ` — ${errText.slice(0, 200)}` : ''}`,
            { itemIndex: i },
          );
        }

        // 204 No Content → return empty object
        const json = apiRes.status === 204 ? {} : await apiRes.json() as IDataObject;
        // session_info: inject userId decoded from JWT sub claim so callers
        // don't need a separate step to obtain the userId required by most operations.
        if (operation === 'session_info' && bearer) {
          try {
            const parts = bearer.split('.');
            if (parts.length === 3) {
              const pad = (s: string) => s + '='.repeat((4 - s.length % 4) % 4);
              const payload = JSON.parse(Buffer.from(pad(parts[1] ?? ''), 'base64').toString('utf8')) as IDataObject;
              const sub = payload.sub ?? payload.userId ?? payload.user_id;
              if (sub && !(json as IDataObject).userId) {
                (json as IDataObject).userId = sub;
              }
            }
          } catch { /* ignore decode errors */ }
        }
        out.push({ json: json as IDataObject });
      } catch (error) {
        if (this.continueOnFail()) {
          out.push({ json: this.getInputData(i)[0].json, error: error as NodeOperationError });
          continue;
        }
        throw error;
      }
    }

    return [out];
  }
}

// HTTP metadata per operation — method + URL template.
// 'stub: true' means the tool has no REST annotation and requires self-hosted n8n.
const OPERATION_META: Record<string, { method: string; urlTemplate: string; stub?: true }> = {
{{#each operations}}  '{{this.name}}': { method: '{{this.httpMethod}}', urlTemplate: {{json this.httpUrlTemplate}}{{safe this.stubSuffix}} },
{{/each}}
};

// Per-operation input property names for argument gathering.
const OPERATION_PROPERTY_NAMES: Record<string, readonly string[]> = {
{{#each operations}}  '{{this.name}}': [{{#each this.properties}}'{{this.name}}'{{#unless @last}}, {{/unless}}{{/each}}],
{{/each}} };

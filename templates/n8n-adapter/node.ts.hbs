    const creds = await this.getCredentials('{{credentialParamName}}');
    const baseUrl = String(creds.baseUrl ?? '').replace(/\/$/, '');

    // --- Obtain Bearer token (once per execute call) ---
{{#if (eq authStyle 'okta-client-credentials')}}

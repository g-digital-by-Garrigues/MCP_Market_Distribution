            if (!state) {
              try {
                const lookupRes = await fetch(lookupUrl, { headers: { Authorization: `Bearer ${bearer}` } });
                if (!lookupRes.ok) continue;
                state = await lookupRes.json().catch(() => ({})) as IDataObject;
              } catch { continue; }
              lookupCache.set(lookupUrl, state);
            }
            let scope: IDataObject | undefined = state;
            if (guard.arrayPath && guard.matchParam) {
              const arr = state[guard.arrayPath];
              const wanted = String(pathParamValues[guard.matchParam] ?? '');

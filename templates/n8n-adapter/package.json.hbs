{
  "name": "{{packageName}}",
  "version": "{{version}}",
  "description": "{{description}}",
  "license": "MIT",
  "homepage": "{{sourceRepoUrl}}",
  "author": "{{author}}",
  "repository": {
    "type": "git",
    "url": "{{sourceRepoUrl}}"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "mcp",
    "{{nodeName}}"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "lint": "eslint nodes credentials --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/{{credentialClassName}}.credentials.js"
    ],
    "nodes": [
      "dist/nodes/{{className}}/{{className}}.node.js"
    ]
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "{{sourceMcpPackageName}}": "{{version}}"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.0.0"
  }
}

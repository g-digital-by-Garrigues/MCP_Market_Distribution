{
  "name": "{{packageName}}",
  "version": "{{version}}",
  "description": "{{description}}",
  "license": "MIT",
  "homepage": "{{sourceRepoUrl}}",
  "author": { "name": "{{author.name}}", "email": "{{author.email}}" },
  "repository": {
    "type": "git",
    "url": "{{sourceRepoUrl}}"
  },
  "keywords": [
    "n8n",
    "n8n-community-node-package",
    "digital-trust",
    "{{nodeName}}"
  ],
  "main": "dist/index.js",
  "scripts": {
    "build": "tsup && copyfiles -u 0 \"nodes/**/*.png\" dist",
    "lint": "eslint nodes credentials --ext .ts",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/{{credentialClassName}}.credentials.js"
    ],
    "nodes": [
      "dist/nodes/{{className}}/{{className}}.node.js"
    ]
  },
  "dependencies": {},
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "copyfiles": "^2.4.1",
    "n8n-workflow": "^1.79.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}

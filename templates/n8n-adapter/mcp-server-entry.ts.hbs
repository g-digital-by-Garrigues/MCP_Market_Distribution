// Standalone MCP server bootstrap — bundled by tsup into dist/mcp-server.mjs.
//
// The n8n node ({{className}}.node.ts) spawns this per execute() call,
// passing credentials via process.env. Each spawn is an isolated process
// so process.env is read fresh — no cross-execution credential bleed.
//
// tsup bundles {{sourceMcpPackageName}} and @modelcontextprotocol/sdk
// into dist/mcp-server.mjs so it is fully self-contained at n8n runtime.
//
// ESM (.mjs) is required when the source MCP uses "type":"module" with
// top-level await — CJS cannot handle top-level await at bundle time.
await import('{{sourceMcpPackageName}}/{{mcpBinRelPath}}');

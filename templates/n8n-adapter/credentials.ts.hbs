import {
  ICredentialTestRequest,
  ICredentialType,
  INodeProperties,
} from 'n8n-workflow';

export class {{credentialClassName}} implements ICredentialType {
  name = '{{credentialParamName}}';
  displayName = '{{displayName}} API';
  documentationUrl = '{{#if credentialAcquisitionUrl}}{{credentialAcquisitionUrl}}{{else}}{{sourceRepoUrl}}{{/if}}';

  properties: INodeProperties[] = [
    {
      displayName: 'API Base URL',
      name: 'baseUrl',
      type: 'string',
      default: '{{defaultApiBaseUrl}}',
      description: 'Base URL of the {{displayName}} REST API. Leave as-is for the production environment{{#if defaultApiBaseUrl}} (default: {{defaultApiBaseUrl}}){{/if}}.',
    },
{{#each credentials}}    {
      displayName: '{{this.displayName}}',
      name: '{{this.propName}}',
      type: 'string',
      {{#if this.isSecret}}typeOptions: { password: true },
      {{/if}}default: '',
      {{#if this.description}}description: {{json this.description}},
      {{/if}}
    },
{{/each}}  ];

{{#if (eq authStyle 'session-login-or-token')}}
  // No *declarative* test here: the auth branches (User Key exchange vs
  // email/password login), which ICredentialTestRequest cannot express. The node
  // supplies a programmatic one instead — see the `testAuth` credentialTest method
  // in the node class, wired up through `testedBy`. The credential still gets its
  // green check on Save, for both flows.
{{else}}
{{#if (eq authStyle 'email-password')}}
  test: ICredentialTestRequest = {
    request: {
      baseURL: '=\{{$credentials.baseUrl}}',
      url: '/session',
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: {
        email: '=\{{$credentials.email}}',
        password: '=\{{$credentials.password}}',
      },
    },
  };
{{else}}
{{#if (eq authStyle 'oauth2-client-credentials')}}
  test: ICredentialTestRequest = {
    request: {
      baseURL: '=\{{$credentials.mcpSvcTokenUrl}}',
      url: '',
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: {
        grant_type: 'client_credentials',
        client_id: '=\{{$credentials.mcpSvcClientId}}',
        client_secret: '=\{{$credentials.mcpSvcClientSecret}}',
        scope: '=\{{$credentials.mcpSvcScope}}',
      },
    },
  };
{{else}}
  test: ICredentialTestRequest = {
    request: {
      baseURL: '=\{{$credentials.oktaTokenUrl}}',
      url: '',
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: {
        grant_type: 'client_credentials',
        client_id: '=\{{$credentials.oktaClientId}}',
        client_secret: '=\{{$credentials.oktaClientSecret}}',
        scope: '=\{{$credentials.oktaScope}}',
      },
    },
  };
{{/if}}
{{/if}}
{{/if}}
}

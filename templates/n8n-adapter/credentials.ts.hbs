// Auto-generated by the g-digital MCP distribution pipeline.
// Source MCP: {{sourceMcpPackageName}} ({{version}})
// Architecture: REST-direct (Epic 12 ADR 0008). Token: fetched by the node for
// session/token auth; for the OAuth2 service-account style, n8n's oAuth2Api acquires it.

import {
{{#unless (eq authStyle 'oauth2-client-credentials')}}{{#unless (eq authStyle 'session-login-or-token')}}  ICredentialTestRequest,
{{/unless}}{{/unless}}  ICredentialType,
  INodeProperties,
} from 'n8n-workflow';

export class {{credentialClassName}} implements ICredentialType {
  name = '{{credentialParamName}}';
{{#if (eq authStyle 'oauth2-client-credentials')}}
  // Epic 16: adopt n8n's built-in OAuth2 client_credentials. Extending oAuth2Api
  // hands token acquisition, caching and refresh to n8n itself.
  extends = ['oAuth2Api'];
  displayName = '{{displayName}} OAuth2 API';
{{else}}
  displayName = '{{displayName}} API';
{{/if}}{{#if iconBundled}}
  icon = 'file:{{#if iconFile}}{{iconFile}}{{else}}icon.png{{/if}}' as const;{{/if}}
  documentationUrl = '{{#if credentialAcquisitionUrl}}{{credentialAcquisitionUrl}}{{else}}{{sourceRepoUrl}}{{/if}}';

  properties: INodeProperties[] = [
    {
      displayName: 'API Base URL',
      name: 'baseUrl',
      type: 'string',
      default: '{{defaultApiBaseUrl}}',
      description: 'Base URL of the {{displayName}} REST API. Leave as-is for the production environment{{#if defaultApiBaseUrl}} (default: {{defaultApiBaseUrl}}){{/if}}.',
    },
{{#if (eq authStyle 'oauth2-client-credentials')}}
    // n8n's oAuth2Api base supplies Client ID, Client Secret, Access Token URL and
    // Scope as editable fields. We only pin the grant type and how the client secret
    // is sent; n8n acquires, caches and refreshes the token itself.
    {
      displayName: 'Grant Type',
      name: 'grantType',
      type: 'hidden',
      default: 'clientCredentials',
    },
    {
      displayName: 'Authentication',
      name: 'authentication',
      type: 'hidden',
      default: 'body',
    },
{{else}}
{{#each credentials}}    {
      displayName: '{{this.displayName}}',
      name: '{{this.propName}}',
      type: 'string',
      {{#if this.isSecret}}typeOptions: { password: true },
      {{/if}}default: '',
      {{#if this.description}}description: {{json this.description}},
      {{/if}}
    },
{{/each}}{{/if}}  ];

{{#if (eq authStyle 'session-login-or-token')}}
  // No *declarative* test here: the auth branches (User Key exchange vs
  // email/password login), which ICredentialTestRequest cannot express. The node
  // supplies a programmatic one instead — see the `testAuth` credentialTest method
  // in the node class, wired up through `testedBy`. The credential still gets its
  // green check on Save, for both flows.
{{else}}
{{#if (eq authStyle 'email-password')}}
  test: ICredentialTestRequest = {
    request: {
      baseURL: '=\{{$credentials.baseUrl}}',
      url: '/session',
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: {
        email: '=\{{$credentials.email}}',
        password: '=\{{$credentials.password}}',
      },
    },
  };
{{else}}
{{#if (eq authStyle 'oauth2-client-credentials')}}
  // No declarative test: extending oAuth2Api makes n8n validate the credential by
  // acquiring a client_credentials token on Save. A hand-rolled test would duplicate
  // (and drift from) that machinery.
{{else}}
  test: ICredentialTestRequest = {
    request: {
      baseURL: '=\{{$credentials.oktaTokenUrl}}',
      url: '',
      method: 'POST',
      headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
      body: {
        grant_type: 'client_credentials',
        client_id: '=\{{$credentials.oktaClientId}}',
        client_secret: '=\{{$credentials.oktaClientSecret}}',
        scope: '=\{{$credentials.oktaScope}}',
      },
    },
  };
{{/if}}
{{/if}}
{{/if}}
}
